# The fixture vault must keep its bytes exactly, CRLF note included.
mcp/brain/fixtures/vault/** -text
# cmd.exe can mis-parse `goto :label` in a batch file with LF endings.
*.bat text eol=crlf
# Shell scripts break with CRLF (a Windows clone with core.autocrlf would add it).
*.command text eol=lf
.githooks/* text eol=lf
