# Firebase web config for the Reader extension's Firestore sync.
#
# Setup: copy this file to `.env.local` and fill in the values from the
# Firebase console: Project settings → General → Your apps → (register/select
# a Web app) → "SDK setup and configuration" → Config.
#
# `.env.local` is gitignored. The web apiKey is a project identifier, not a
# secret (it ships in the built client bundle), but keep it out of source and
# restrict it in the Google Cloud Console. Leaving VITE_FIREBASE_API_KEY blank
# keeps cloud sync disabled.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: pin the extension id (base64 DER public key → manifest "key") so it
# survives loading the extension from a different folder. Nothing requires it —
# Google Calendar credentials are entered in Settings, not at build time (see
# docs/google-calendar-setup.md) — but a stable id means a stable OAuth redirect
# URI, so you register it on your Google client once.
VITE_CRX_PUBLIC_KEY=
