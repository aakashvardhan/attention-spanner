{
  "name": "chrome-reader",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:content",
    "build:content": "esbuild src/content/readingTracker.ts src/content/videoTracker.ts src/content/timedtextTee.ts --bundle --format=iife --outdir=dist/content --log-level=error",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "package": "node scripts/package.mjs",
    "build:e2e": "E2E=1 npm run build",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "fast-xml-parser": "^5.10.1",
    "katex": "^0.18.2",
    "marked": "^18.0.7",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0",
    "@types/chrome": "^0.0.323",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.1",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.61.1",
    "typescript": "~5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  }
}
